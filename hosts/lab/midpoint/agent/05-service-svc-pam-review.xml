<?xml version="1.0" encoding="UTF-8"?>
<!--
  pam-review's identity: the AI PAM reviewer on ai01 is an AI agent too, so it
  gets the same lifecycle as the ops agent (AI Agent archetype -> AD account in
  OU=AI Agents, enabled only while it's valid AND a sponsor is active).

  Set validTo (expiry) as needed; then, in the UI, open an IT user and add an
  assignment to this service with relation "Owner": that person is the
  reviewer's sponsor. The recompute task (04) already covers it.

  If the sponsor leaves or it expires, pam-review can no longer log in to
  Boundary and session review stops: pam-review reports that to Wazuh
  (rule 100120), so the gap in monitoring is visible.

  UNTESTED: import via Configuration > Import object.
-->
<service xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
         oid="7f1b8c2e-3a54-4d1e-9b6a-a1a9e0e0a904">
    <name>svc-pam-review</name>
    <description>AI PAM reviewer on ai01: reads Boundary sessions (read-only) and triages risky ones with a local LLM.</description>
    <assignment>
        <targetRef oid="7f1b8c2e-3a54-4d1e-9b6a-a1a9e0e0a901" type="ArchetypeType"/>
    </assignment>
    <activation>
        <administrativeStatus>enabled</administrativeStatus>
        <validTo>2027-02-08T00:00:00Z</validTo>
    </activation>
</service>
